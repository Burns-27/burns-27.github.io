THEME=https://raw.githubusercontent.com/catppuccin/obsidian/HEAD/theme.css
BASE_THEME=dark
dgHomeLink=true
dgShowBacklinks=true
dgShowLocalGraph=true
dgShowInlineTitle=true
dgShowFileTree=true
dgEnableSearch=true
dgShowToc=true
dgLinkPreview=true
dgShowTags=true
SITE_NAME_HEADER=Sharon's Thought Garden
SITE_MAIN_LANGUAGE=en
SITE_BASE_URL=
SHOW_CREATED_TIMESTAMP=false
TIMESTAMP_FORMAT=MMM dd, yyyy h:mm a
SHOW_UPDATED_TIMESTAMP=false
NOTE_ICON_DEFAULT=
NOTE_ICON_TITLE=false
NOTE_ICON_FILETREE=false
NOTE_ICON_INTERNAL_LINKS=false
NOTE_ICON_BACK_LINKS=false
STYLE_SETTINGS_CSS=body.css-settings-manager { --h1-color: rgb(var(--my-purple)); --h2-color: rgb(var(--my-purple)); --h3-color: rgb(var(--my-lavender)); --h4-color: rgb(var(--my-lightBlue)); --h6-color: rgb(var(--my-yellow)); --highlight-color: var(--my-accent); --checkbox-current-color: rgb(var(--my-lightBlue)); --checkbox-done-color: rgb(var(--my-green)); --checkbox-canceled-color: rgb(var(--my-red)); --checkbox-migrated-color: rgb(var(--my-lightBlue)); --checkbox-idea-color: rgb(var(--my-yellow)); --checkbox-question-color: rgb(var(--my-blue)); --checkbox-research-color: rgb(var(--my-blue)); --checkbox-halfdone-color: rgb(var(--my-purple)); --checkbox-favorite-color: rgb(var(--my-pink)); --property-category-color: rgb(var(--my-purple)); --property-type-color: rgb(var(--my-lavender)); --property-subtype-color: rgb(var(--my-lightBlue)); --property-status-color: rgb(var(--my-blue)); --strikethrough-color: rgb(var(--my-off-white)); --h5-color: rgb(var(--my-green)); --bold-color: rgb(var(--my-blue)); --italic-color: rgb(var(--my-lavender)); --bold-italic-color: rgb(var(--my-lightBlue)); } body.theme-light.css-settings-manager { } body.theme-dark.css-settings-manager { }
STYLE_SETTINGS_BODY_CLASSES=theme-dark mod-windows is-frameless is-hidden-frameless obsidian-app styled-scrollbars show-inline-title is-floating-nav auto-full-screen show-ribbon show-view-header is-maximized folder-notes-plugin hide-folder-note folder-note-underline folder-note-underline-path fn-whitespace-stop-collapsing fn-ignore-attachment-folder disable-folder-highlight version-1-7-2 css-settings-manager ctp-mocha ctp-accent-mauve ctp-tag-pill is-focused
USE_FULL_RESOLUTION_IMAGES=false
dgPassFrontmatter=false